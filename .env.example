# 合同审查助手 · 环境配置模板
#
# 用法:把这个文件复制成同目录下的 .env,填上你自己的值,然后启动服务。
#        项目启动时会自动读取项目根目录的 .env(同名环境变量优先于本文件)。
#
# ⚠️ .env 里是你的私钥,不要提交到 git、不要打包给别人。
#    换台电脑就给对方这个 .env.example,让对方自己申请一把 key 填进去。

# ---------- 必填:DeepSeek API Key ----------
# 申请地址 https://platform.deepseek.com/ (充值后创建 API key,形如 sk-xxxxxxxx)
DEEPSEEK_API_KEY=sk-在这里填你自己的key

# ---------- 可选 ----------
# 接口地址(默认官方)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名(默认 deepseek-chat;想用思考型可换 deepseek-reasoner)
# LLM_MODEL=deepseek-chat

# bge-m3 向量模型目录。默认查找顺序:
#   本变量 → 项目内 models/bge-m3 → 开发者本机旧目录(别人机器上没有)
# 把模型放在 项目/models/bge-m3/ 就不用配这一项
# BGE_MODEL_PATH=D:\models\bge-m3

# MinerU 可执行文件路径。默认用项目 venv 里的 mineru(.venv/Scripts/mineru.exe)
# MINERU_EXE=

# MinerU 模型下载源(默认 modelscope;换机器首次解析会用到)
# MINERU_MODEL_SOURCE=modelscope
